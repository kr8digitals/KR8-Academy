# KR8 Academy — environment variables
# Everything works without any of these (in-code defaults + honest fallbacks).
# Copy to .env.local for local overrides; set these in Vercel → Project → Settings → Environment Variables for production.

# --- Shared cloud registrar (Supabase, KR8-Academy project) ---
# The publishable key is public-by-design and RLS-gated to anonymous INSERT only;
# in-code defaults point at the live project, so these are overrides, not requirements.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Google sign-in (/join) ---
# Google Cloud OAuth "Web application" client id. Without it the Google button
# says Google is being connected — the WhatsApp path carries sign-in.
VITE_GOOGLE_CLIENT_ID=

# --- Transactional messaging (serverless API routes, never exposed to the browser) ---
# Meta WhatsApp Cloud API — used for one-time codes and automatic WhatsApp sends.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Resend — waitlist/application/certificate confirmations.
RESEND_API_KEY=

# --- Stats endpoint (optional) ---
# Shared secret so /api/stats can report aggregate numbers to trusted callers only.
STATS_API_KEY=
