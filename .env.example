# KR8 Academy — optional integrations
# The core learning, application and registration flows work without these.

# Google sign-in (/join)
# Google Cloud OAuth Web application client ID.
VITE_GOOGLE_CLIENT_ID=

# Transactional messaging (serverless API routes; never exposed to the browser)
# Meta WhatsApp Cloud API — used only for opted-in one-time codes and messages.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Resend — transactional messages and Academy interest enquiries.
RESEND_API_KEY=

# Stats endpoint (optional)
STATS_API_KEY=
